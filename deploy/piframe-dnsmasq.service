[Unit]
Description=PiFrame setup hotspot DHCP/DNS (dnsmasq)
# Started only by piframe-netctl ap-up. Uses its own config so it never
# touches a system-wide dnsmasq the user may rely on elsewhere.
Requires=piframe-hostapd.service
After=piframe-hostapd.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq -k -C /etc/piframe/dnsmasq.conf
Restart=no
StandardOutput=journal
StandardError=journal
