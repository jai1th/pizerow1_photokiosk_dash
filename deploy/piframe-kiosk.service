[Unit]
Description=PiFrame kiosk browser (surf/WebKit via X/fbdev)
# Start after the backend unit has been activated; the ExecStartPre wait-loop
# below ensures we don't try to open the browser until Flask is responding.
After=piframe.service
Wants=piframe.service

[Service]
User=dietpi
# video group gives the X server (running setuid via xserver-xorg-legacy)
# access to /dev/fb0 and input devices on the Pi's framebuffer.
SupplementaryGroups=video

# Poll /api/status until the backend answers (up to 120 s).
# Tries every 2 s; exits 1 on timeout so systemd will restart and retry.
ExecStartPre=/bin/bash -c '\
  for i in $(seq 1 60); do \
    curl -sf http://127.0.0.1:5000/api/status >/dev/null 2>&1 && exit 0; \
    sleep 2; \
  done; \
  echo "piframe-kiosk: backend not ready after 120 s" >&2; \
  exit 1'

ExecStart=/usr/bin/xinit /usr/bin/surf -F http://127.0.0.1:5000/ -- :0 vt1

Restart=always
RestartSec=3
TimeoutStartSec=130
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
