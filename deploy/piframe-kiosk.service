[Unit]
Description=PiFrame kiosk browser (Cog/WPE WebKit via DRM/KMS)
# Start after the backend unit has been activated; the ExecStartPre wait-loop
# below ensures we don't try to open the browser until Flask is responding.
After=piframe.service
Wants=piframe.service

[Service]
User=dietpi
# Direct DRM/KMS access requires membership in the video and render groups.
# install.sh adds dietpi to both; this line is belt-and-suspenders.
SupplementaryGroups=video render

# Poll /api/status until the backend answers (up to 120 s).
# Tries every 2 s; exits 1 on timeout so systemd will restart and retry.
ExecStartPre=/bin/bash -c '\
  for i in $(seq 1 60); do \
    curl -sf http://127.0.0.1:5000/api/status >/dev/null 2>&1 && exit 0; \
    sleep 2; \
  done; \
  echo "piframe-kiosk: backend not ready after 120 s" >&2; \
  exit 1'

ExecStart=/usr/bin/cog -P drm http://127.0.0.1:5000/

Restart=always
RestartSec=3
TimeoutStartSec=130
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
